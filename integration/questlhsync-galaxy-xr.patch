   CoTaskMemFree(p);
+  // Keep a new headset's station geometry and timing separate from old headsets.
+  char profile[64] = {};
+  vr::EVRSettingsError error;
+  vr::VRSettings()->GetString(kSection, "profile", profile, sizeof(profile), &error);
